<Window x:Class="MeetingRoom.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="会議室予約システム" Height="680" Width="1040"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="6" Padding="18,14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="会議室予約システム" Foreground="White" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="会議室の予約登録・キャンセルができます。同一会議室の時間帯重複は登録できません。"
                           Foreground="#DCE6FB" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 会議室一覧 -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="会議室一覧" Style="{StaticResource Heading}" />
                    <ListBox x:Name="RoomList" DockPanel.Dock="Top" BorderThickness="0"
                             SelectionChanged="RoomList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7F9FC" CornerRadius="4" Padding="10,8"
                                        BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Capacity, StringFormat=定員 {0} 名}"
                                                       Foreground="#666" FontSize="11" />
                                            <TextBlock Text="{Binding Location}" Foreground="#666"
                                                       FontSize="11" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 予約フォーム -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="予約登録" Style="{StaticResource Heading}" />

                    <TextBlock Text="会議室" Style="{StaticResource Label}" />
                    <ComboBox x:Name="RoomCombo" DisplayMemberPath="Name" />

                    <TextBlock Text="日付" Style="{StaticResource Label}" />
                    <DatePicker x:Name="DatePick" Height="30" />

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="開始時刻" Style="{StaticResource Label}" />
                            <ComboBox x:Name="StartCombo" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="終了時刻" Style="{StaticResource Label}" />
                            <ComboBox x:Name="EndCombo" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="件名" Style="{StaticResource Label}" />
                    <TextBox x:Name="TitleBox" />

                    <TextBlock Text="予約者" Style="{StaticResource Label}" />
                    <TextBox x:Name="ReservedByBox" />

                    <Button Content="予約する" Style="{StaticResource PrimaryButton}"
                            Margin="0,16,0,0" Click="Reserve_Click" />
                </StackPanel>
            </Border>

            <!-- 予約一覧 -->
            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Padding="14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBlock Text="予約一覧" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                        <CheckBox x:Name="FilterCheck" Content="選択中の会議室のみ表示" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="Filter_Click" />
                    </Grid>

                    <Button DockPanel.Dock="Bottom" Content="選択した予約をキャンセル"
                            Style="{StaticResource DangerButton}" Margin="0,12,0,0"
                            HorizontalAlignment="Right" Click="Cancel_Click" />

                    <DataGrid x:Name="ReservationGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" RowHeight="34" CanUserAddRows="False"
                              Background="White" RowBackground="White" AlternatingRowBackground="#F7F9FC"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="会議室" Binding="{Binding RoomName}" Width="120" />
                            <DataGridTextColumn Header="件名" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="日時" Binding="{Binding TimeRange}" Width="190" />
                            <DataGridTextColumn Header="予約者" Binding="{Binding ReservedBy}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
